  {
    "id": "sys_recyclebin",
    "category": "system",
    "name": "清空回收站",
    "desc": "永久删除回收站中的全部文件，无法再恢复，请确认回收站中没有想保留的内容",
    "paths": [],
    "risk": "yellow",
    "defaultChecked": false,
    "method": "exec",
    "execCommand": "Clear-RecycleBin -Force -ErrorAction SilentlyContinue",
    "execTimeoutSec": 120
  },
  {
    "id": "sys_eventlogs",
    "category": "system",
    "name": "事件日志",
    "desc": "系统与应用事件日志，删除后不再可查，通常价值有限",
    "paths": [],
    "risk": "yellow",
    "defaultChecked": false,
    "method": "exec",
    "execCommand": "Get-WinEvent -ListLog * | ForEach-Object { try { [System.Diagnostics.Eventing.Reader.EventLogSession]::GlobalSession.ClearLog($_.LogName) } catch {} }",
    "execTimeoutSec": 120,
    "admin": true
  },
  {
    "id": "sys_winsxs",
    "category": "system",
    "name": "Windows 组件清理 (DISM)",
    "desc": "清理 WinSxS 组件存储中的过期更新组件，需要数分钟，请耐心等待",
    "paths": [],
    "risk": "yellow",
    "defaultChecked": false,
    "method": "exec",
    "execCommand": "DISM /Online /Cleanup-Image /StartComponentCleanup /Quiet",
    "execTimeoutSec": 600,
    "admin": true
  },
  {
    "id": "sys_oldwindows",
