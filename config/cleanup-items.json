  {
    "id": "browser_firefox",
    "category": "browser",
    "name": "Firefox 浏览器缓存",
    "desc": "Firefox 配置目录下的缓存文件夹（不影响书签/密码/登录状态）",
    "paths": [],
    "risk": "green",
    "defaultChecked": false,
    "method": "exec",
    "execCommand": "$p = Join-Path $env:APPDATA 'Mozilla\\Firefox\\Profiles'; if (Test-Path $p) { Get-ChildItem $p -Directory | ForEach-Object { $c = Join-Path $_.FullName 'cache2'; if (Test-Path $c) { Remove-Item -LiteralPath $c -Recurse -Force -ErrorAction SilentlyContinue } } }",
    "execTimeoutSec": 120,
    "detect": { "type": "path-exists", "value": ["%APPDATA%\\Mozilla\\Firefox\\Profiles"] }
  },

